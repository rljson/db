{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/db",

  // 1-2 sentence summary about this repo.
  "summary": "High-level database on an Io: get/insert by route over components, trees, cakes, layers, sliceIds; insert history, time travel, Join, multi-edits, edit chains. Connector: client side of the sync protocol.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "content-addressed, immutable data: route queries, insert history, DAG-branch conflict detection, query cache",
    "Join (column selection, row filter/sort, setValue), MultiEditManager, EditChainManager",
    "Connector: refs over a socket (dedup, gap fill, predecessors, bootstrap, stamps), stateBeaconEvent"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "rljson": "routes, table types, Connector wire types (ConnectorPayload, SyncConfig), syncEvents, Validate/BaseValidator on import",
      "io": "Io, IoMem: storage; Socket: Connector transport",
      "hash": "hip/hsh/rmhsh: rows, inserts, edits",
      "json": "Json types, equals, merge",
      "converter": "test: mass data (fromJson, DecomposeChart)"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "server": "Db, Connector, stateBeaconEvent",
      "fs-agent": "Db, Connector, trees (insertTrees), stateBeaconEvent",
      "mongo-agent": "Db, MultiEditManager; Connector subset (EditSyncConnector)"
    }
  }
}
