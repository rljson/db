{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/db",

  // 1-2 sentence summary about this repo.
  "summary": "High-level read/write layer over any Io: routes, controllers (tree, cake, layer, component, sliceIds), joins, inserts with insert history, multi-edits, Connector for ref sync. One event model (DbEvents): hooks before reads/writes (allow, refuse, filter), observers after writes and inserts (Notify).",

  // 1-3 bullet points: the problem space.
  "domain": [
    "query and insert hierarchical, content-addressed Rljson data by route",
    "sync refs between nodes: Connector, stamps, ACK, gap-fill, conflicts",
    "event model: before hooks with priority, loop protection, context; EventIo wraps any Io; MockHook for tests"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "rljson": "Route, Rljson, TableCfg, InsertHistoryRow, sync types",
      "io": "Io (wrapped by EventIo), IoMem",
      "hash": "hip, hsh, rmhsh; rehash filtered tables",
      "json": "Json, JsonValue",
      "validate": "data validation on import"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "server": "Db, DbEvents, Connector, stateBeaconEvent",
      "fs-agent": "Db, Connector",
      "cos-one-client": "Db, Connector",
      "cos-cloud-platform-app": "Db, Connector"
    }
  }
}
